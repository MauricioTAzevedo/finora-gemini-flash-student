# ==============================================================================
# Finora Gemini Flash Student — Environment Configuration
# ==============================================================================

# Server
PORT=8080
ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Canonical Storage
DATABASE_URL=postgres://finora:finora_secret@localhost:5432/finora_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_DEFAULT_CURRENCY=BRL

# AI Service (Python)
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Event Messaging & Cache (Future / Milestone 5)
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finora-documents
S3_USE_SSL=false
